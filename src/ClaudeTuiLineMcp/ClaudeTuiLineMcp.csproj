<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>claude-tui-line-mcp</AssemblyName>
    <RootNamespace>ClaudeTuiLineMcp</RootNamespace>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPEC-12.6-mcp-tools.md §7.1: the only allowed core reference is
         ClaudeTuiLine.ConfigLoader.ResolveConfigPath() (and, per A2, at most one conditional
         member if the core exposes a reusable SHA-256 helper or atomic writer — it does not,
         per E1, so the allow-list stays at one member). V4 enforces this structurally. -->
    <ProjectReference Include="../ClaudeTuiLine/ClaudeTuiLine.csproj" />
  </ItemGroup>

</Project>
